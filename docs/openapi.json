    "components": {
        "schemas": {
            "ChatRequest": {
                "properties": {
                    "question": {
                        "type": "string",
                        "maxLength": 2000,
                        "minLength": 1,
                        "title": "Question"
                    }
                },
                "type": "object",
                "required": [
                    "question"
                ],
                "title": "ChatRequest"
            },
            "ClientCreate": {
                "properties": {
                    "first_name": {
                        "type": "string",
                        "maxLength": 200,
                        "minLength": 1,
                        "title": "First Name"
                    },
                    "last_name": {
                        "type": "string",
                        "maxLength": 200,
                        "minLength": 1,
                        "title": "Last Name"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "title": "Email"
                    },
                    "description": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 5000
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Description"
                    },
                    "social_links": {
                        "anyOf": [
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Social Links"
                    }
                },
                "type": "object",
                "required": [
                    "first_name",
                    "last_name",
                    "email"
                ],
                "title": "ClientCreate"
            },
            "ClientOut": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Id"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email"
                    },
                    "description": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Description"
                    },
                    "social_links": {
                        "anyOf": [
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Social Links"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "first_name",
                    "last_name",
                    "email",
                    "created_at"
                ],
                "title": "ClientOut"
            },
            "ClientPage": {
                "properties": {
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/ClientOut"
                        },
                        "type": "array",
                        "title": "Items"
                    },
                    "next_cursor": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Next Cursor",
                        "description": "Opaque cursor for the next page; null if no more results"
                    },
                    "has_more": {
                        "type": "boolean",
                        "title": "Has More",
                        "description": "Whether more results exist",
                        "default": false
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "description": "Number of items in this page"
                    }
                },
                "type": "object",
                "required": [
                    "items",
                    "count"
                ],
                "title": "ClientPage",
                "description": "Cursor-paginated response for clients."
            },
            "ClientResult": {
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "client",
                        "title": "Type",
                        "default": "client"
                    },
                    "score": {
                        "type": "number",
                        "title": "Score"
                    },
                    "client": {
                        "$ref": "#/components/schemas/SearchHitClient"
                    }
                },
                "type": "object",
                "required": [
                    "score",
                    "client"
                ],
                "title": "ClientResult"
            },
            "DocumentCreate": {
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 500,
                        "minLength": 1,
                        "title": "Title"
                    },
                    "content": {
                        "type": "string",
                        "maxLength": 1000000,
                        "minLength": 1,
                        "title": "Content"
                    }
                },
                "type": "object",
                "required": [
                    "title",
                    "content"
                ],
                "title": "DocumentCreate"
            },
            "DocumentListItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Id"
                    },
                    "client_id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Client Id"
                    },
                    "client_name": {
                        "type": "string",
                        "title": "Client Name"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title"
                    },
                    "content": {
                        "type": "string",
                        "title": "Content"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "client_id",
                    "client_name",
                    "title",
                    "content",
                    "created_at"
                ],
                "title": "DocumentListItem"
            },
            "DocumentOut": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Id"
                    },
                    "client_id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Client Id"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title"
                    },
                    "content": {
                        "type": "string",
                        "title": "Content"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "client_id",
                    "title",
                    "content",
                    "created_at"
                ],
                "title": "DocumentOut"
            },
            "DocumentPage": {
                "properties": {
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/DocumentListItem"
                        },
                        "type": "array",
                        "title": "Items"
                    },
                    "next_cursor": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
