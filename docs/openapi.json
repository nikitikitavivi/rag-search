                        "title": "Next Cursor",
                        "description": "Opaque cursor for the next page"
                    },
                    "has_more": {
                        "type": "boolean",
                        "title": "Has More",
                        "default": false
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count"
                    }
                },
                "type": "object",
                "required": [
                    "items",
                    "count"
                ],
                "title": "DocumentPage"
            },
            "DocumentResult": {
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "document",
                        "title": "Type",
                        "default": "document"
                    },
                    "score": {
                        "type": "number",
                        "title": "Score"
                    },
                    "document": {
                        "$ref": "#/components/schemas/SearchHitDocument"
                    }
                },
                "type": "object",
                "required": [
                    "score",
                    "document"
                ],
                "title": "DocumentResult"
            },
            "ErrorDetail": {
                "properties": {
                    "code": {
                        "type": "string",
                        "title": "Code",
                        "examples": [
                            "CLIENT_NOT_FOUND"
                        ]
                    },
                    "message": {
                        "type": "string",
                        "title": "Message",
                        "examples": [
                            "Client not found"
                        ]
                    },
                    "resource_id": {
                        "anyOf": [
                            {
                                "type": "string"
