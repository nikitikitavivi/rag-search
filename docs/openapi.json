{
  "openapi": "3.1.0",
  "info": {
    "title": "RAG Search API",
    "description": "WealthTech search API across clients and documents. v1: client full-text search, document CRUD + embedding, LLM summaries.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/clients": {
      "post": {
        "tags": [
          "clients"
        ],
        "summary": "Create a client",
        "operationId": "create_client_v1_clients_post",
